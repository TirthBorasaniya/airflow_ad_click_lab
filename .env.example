# Copied to .env by setup.sh. AIRFLOW_UID is filled in automatically.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Shared secrets for all Airflow containers; setup.sh fills these in with random values.
AIRFLOW_JWT_SECRET=
AIRFLOW_SECRET_KEY=

# Optional email notifications. Leave empty to log notifications to artifacts/notifications.log.
# For Gmail, SMTP_PASSWORD must be an app password: https://support.google.com/accounts/answer/185833
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
